    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.0",
    "@replit/codemirror-vim": "^6.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
